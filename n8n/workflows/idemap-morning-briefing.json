{
  "id": "idemap-morning-briefing-02",
  "name": "IdeMap — Morning Proposal Plan (07:00 AM Cron + Webhook)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "node-morning-cron",
      "name": "Morning 07:00 AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 220]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "idemap-morning-briefing",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-morning-webhook",
      "name": "Manual Morning Plan Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 420],
      "webhookId": "idemap-morning-briefing"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fzynqetgqohgeqsdnttm.supabase.co/rest/v1/rpc/get_universe_ai_snapshot",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "sb_publishable_h5qp70G8q8wVfI9QrFa7mw_hiflEA4i"
            },
            {
              "name": "Authorization",
              "value": "Bearer sb_publishable_h5qp70G8q8wVfI9QrFa7mw_hiflEA4i"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_universe_id: $json.body?.universeId || 'a1361b3c-32f2-4fed-a637-200ac9ecb861', p_planet_id: null }) }}",
        "options": {}
      },
      "id": "node-morning-snapshot",
      "name": "Fetch Last Night Metrics & Universe JSON",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 320]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Synthesize a Morning Proposal Plan for today ({{ $json.today }}) based on last night's 3-metric check-in and open tasks.\n\nUniverse Snapshot JSON:\n{{ JSON.stringify($json, null, 2) }}\n\nInclude:\n1. **Calibration from Last Night**: How yesterday's 3 metrics ({{ $json.daily_metrics?.[0]?.label_1 || 'Clarity' }}: {{ $json.daily_metrics?.[0]?.score_1 || 'N/A' }}/5, {{ $json.daily_metrics?.[0]?.label_2 || 'Sovereignty' }}: {{ $json.daily_metrics?.[0]?.score_2 || 'N/A' }}/5, {{ $json.daily_metrics?.[0]?.label_3 || 'Vitality' }}: {{ $json.daily_metrics?.[0]?.score_3 || 'N/A' }}/5) shape today's tempo.\n2. **Primary Boss Mission**: The single highest-leverage task to complete first.\n3. **Two Orbit Stabilizers**: Quick momentum wins across secondary planets.\n4. **Vitality & Strain Guardrail**: One concrete boundary for today.",
        "options": {
          "systemMessage": "You are the IdeMap Morning Briefing Strategist. Write a crisp, energizing daily proposal plan calibrated to the user's 3 metrics from last night and their active planetary missions."
        }
      },
      "id": "node-morning-agent",
      "name": "Morning Plan Strategist",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [760, 320]
    },
    {
      "parameters": {
        "model": "google/gemini-2.5-flash",
        "options": {
          "temperature": 0.4
        }
      },
      "id": "node-morning-llm",
      "name": "OpenRouter / Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [760, 540]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fzynqetgqohgeqsdnttm.supabase.co/rest/v1/briefings?on_conflict=universe_id,briefing_date,briefing_type",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "sb_publishable_h5qp70G8q8wVfI9QrFa7mw_hiflEA4i"
            },
            {
              "name": "Authorization",
              "value": "Bearer sb_publishable_h5qp70G8q8wVfI9QrFa7mw_hiflEA4i"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ universe_id: $('Fetch Last Night Metrics & Universe JSON').item.json.universe_id, briefing_date: $('Fetch Last Night Metrics & Universe JSON').item.json.today, briefing_type: 'morning', title: '☀️ Morning Orbital Gameplan', summary: $json.output, is_read: false }) }}",
        "options": {}
      },
      "id": "node-save-morning-briefing",
      "name": "Save Morning Plan to Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 320]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, briefing: $json }) }}",
        "options": {}
      },
      "id": "node-respond-morning",
      "name": "Respond Morning Plan",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1280, 320]
    }
  ],
  "connections": {
    "Morning 07:00 AM Trigger": {
      "main": [
        [
          {
            "node": "Fetch Last Night Metrics & Universe JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Morning Plan Webhook": {
      "main": [
        [
          {
            "node": "Fetch Last Night Metrics & Universe JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Last Night Metrics & Universe JSON": {
      "main": [
        [
          {
            "node": "Morning Plan Strategist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenRouter / Gemini Model": {
      "ai_languageModel": [
        [
          {
            "node": "Morning Plan Strategist",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Morning Plan Strategist": {
      "main": [
        [
          {
            "node": "Save Morning Plan to Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Morning Plan to Supabase": {
      "main": [
        [
          {
            "node": "Respond Morning Plan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
