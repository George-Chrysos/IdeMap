        ]
      ]
    },
    "Night Check-In Webhook": {
      "main": [
        [
          {
            "node": "Fetch Completed Missions & 3-Metric History",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Completed Missions & 3-Metric History": {
      "main": [
        [
          {
            "node": "Night Debrief Strategist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenRouter / Gemini Model": {
      "ai_languageModel": [
        [
          {
            "node": "Night Debrief Strategist",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Night Debrief Strategist": {
      "main": [
        [
          {
            "node": "Save Night Briefing to Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Night Briefing to Supabase": {
      "main": [
        [
          {
            "node": "Respond Night Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
